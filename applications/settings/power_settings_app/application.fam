App(
    appid="power_settings",
    name="Power",
    # Loaded from SD so the firmware fits below the full BLE stack
    apptype=FlipperAppType.EXTSETTINGS,
    entry_point="power_settings_app",
    requires=[
        "gui",
        "power",
        "locale",
    ],
    flags=["InsomniaSafe"],
    stack_size=1 * 1024,
    order=10,
    fap_libs=["assets"],
    fap_category="assets",
)
